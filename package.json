{
  "name": "ethos-log-viewer",
  "productName": "Ethos Log Viewer",
  "version": "2026.10.1",
  "description": "Telemetrie-Logs vom Ethos-Sender auswerten und automatisch vom Sender ins Archiv synchronisieren",
  "author": "Christoph Mächler",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "test": "node --test test/sync.test.js test/update.test.js test/eject.test.js test/mcp.test.js",
    "dist": "npm run prepare-app && electron-builder --publish never",
    "handbuch": "node scripts/handbuch.js",
    "build-pwa": "node scripts/build-pwa.js",
    "build-android": "node scripts/build-pwa.js --beispiel-verschoben && cap sync android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0"
  },
  "devDependencies": {
    "@azure/msal-browser": "4.30.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "chart.js": "4.4.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrskynavi/ethos-log-viewer.git"
  },
  "build": {
    "appId": "ch.maechler.ethoslogviewer",
    "productName": "Ethos Log Viewer",
    "files": [
      "src/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ethos-Log-Viewer-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "artifactName": "Ethos-Log-Viewer-${version}.${ext}",
      "hardenedRuntime": false
    },
    "publish": null,
    "extraResources": [
      {
        "from": "src/mcp-stdio.js",
        "to": "mcp-stdio.js"
      }
    ]
  }
}
